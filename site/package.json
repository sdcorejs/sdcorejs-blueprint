{
  "name": "@sdcorejs-blueprint/site",
  "private": true,
  "type": "module",
  "description": "Site HTML trình bày lại Markdown của angular-portal. Markdown là nguồn quy tắc.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:sync": "node scripts/check-sync.mjs",
    "sync:accept": "node scripts/check-sync.mjs --accept",
    "test": "node --test scripts/test/*.test.mjs",
    "test:e2e": "playwright test",
    "serve": "node scripts/serve.mjs",
    "check": "npm run check:sync && npm test && npm run build && npm run test:e2e"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@playwright/test": "1.63.0",
    "github-slugger": "2.0.0",
    "shiki": "4.5.0"
  }
}
